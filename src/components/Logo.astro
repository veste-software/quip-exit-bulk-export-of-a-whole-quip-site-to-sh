---
/** Packout mark, "the taped seam" (same shapes as public/brand/logo.svg): a carton from above,
    its seam sealed by one strip of tape torn off below the edge, and the red fragile sticker. */
import { url } from '../lib/url';
---
<a class="logo" href={url('')} aria-label="Packout, home">
  <img src={url('brand/logo.svg')} width="36" height="36" alt="" />
  <span class="wordmark">Packout</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.625rem; min-height: var(--control-h); text-decoration: none; color: var(--ink); }
  .logo:hover { color: var(--ink); }
  .wordmark { font-family: var(--font-display); font-weight: 800; font-size: 1.75rem; text-transform: uppercase; letter-spacing: 0.04em; line-height: 1; }
  @media (max-width: 30rem) { .wordmark { font-size: 1.5rem; } }
</style>
