---
/** Shell for the long pages: a kicker, a headline, then an 8-column text block. */
import Base from './Base.astro';
interface Props { title: string; description: string; kicker: string; heading: string; lead?: string }
const { title, description, kicker, heading, lead } = Astro.props;
---
<Base title={title} description={description}>
  <article class="wrap page">
    <header class="page__head">
      <p class="label-text kicker">{kicker}</p>
      <h1>{heading}</h1>
      {lead && <p class="lead">{lead}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .page { padding-block: var(--s6) var(--s4); }
  .page__head { max-width: 52rem; margin-bottom: var(--s4); }
  .prose :global(h2) { margin-top: var(--s6); padding-top: var(--s2); border-top: var(--rule-strong); }
  .prose :global(h3) { margin-top: var(--s3); }
  .prose :global(ol), .prose :global(ul) { padding-left: 1.25rem; }
  .prose :global(li) { margin-bottom: var(--s1); }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.9375rem; }
  .prose :global(pre) { font-family: var(--font-mono); font-size: 0.9375rem; background: var(--label); border: var(--rule-strong); padding: var(--s2); overflow-x: auto; margin: 0 0 var(--s2); }
  .prose :global(.wide) { max-width: none; }
</style>
