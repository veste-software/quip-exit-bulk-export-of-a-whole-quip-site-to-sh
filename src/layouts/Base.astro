---
// The brand kit: self-hosted fonts (@fontsource, no CDN), tokens and base styles. See DESIGN.md.
import '@fontsource/big-shoulders-stencil-display/latin-800';
import '@fontsource/ibm-plex-sans/latin-400';
import '@fontsource/ibm-plex-sans/latin-400-italic';
import '@fontsource/ibm-plex-sans/latin-600';
import '@fontsource/ibm-plex-mono/latin-400';
import '@fontsource/ibm-plex-mono/latin-500';
import '../styles/brand.css';
import '../styles/components.css';
import Logo from '../components/Logo.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Cloudflare Web Analytics: cookie-free, only rendered when the token is set at build time.
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

// Structured data that is true for the page: the tool on the home page, breadcrumbs on the rest.
const siteRoot = new URL(import.meta.env.BASE_URL, Astro.site).href;
const segments = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/').split('/').filter(Boolean);
const schemas: object[] = [];
if (segments.length === 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Packout',
    url: siteRoot,
    description,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any (runs in a web browser)',
    offers: [
      { '@type': 'Offer', name: 'Free: dry run and export of up to 20 documents', price: '0', priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Site pass', price: '149', priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Large site pass', price: '390', priceCurrency: 'EUR' },
    ],
  });
} else if (segments.length === 1 && !['impressum', 'datenschutz', '404', 'styleguide'].includes(segments[0])) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Packout', item: siteRoot },
      { '@type': 'ListItem', position: 2, name: title.split(' | ')[0], item: canonical },
    ],
  });
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Packout" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta name="theme-color" content="#dfcba6" />
  </head>
  <body>
    <a class="skip label-text" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <Logo />
        <nav aria-label="Main">
          <a href={url('pricing/')}>Pricing</a>
          <a href={url('security/')}>Security</a>
          <a href={url('quip-retirement-timeline/')}>Deadlines</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-row">
        <p class="disclaimer">
          Packout is an independent tool. It is not affiliated with, endorsed by or sponsored by Salesforce or Quip.
          “Quip” and “Salesforce” are trademarks of Salesforce, Inc., used here only to describe what this tool exports.
        </p>
        <nav aria-label="Legal and help">
          <a href={url('security/')}>Security</a>
          <a href={url('pricing/')}>Pricing</a>
          <a href={url('impressum/')}>Impressum</a>
          <a href={url('datenschutz/')}>Datenschutz / Privacy</a>
        </nav>
      </div>
    </footer>
    {cfToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfToken })}
      ></script>
    )}
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 0; background: var(--label); padding: var(--s1) var(--s2); }
  .skip:focus { left: var(--s2); z-index: 10; }
  .site-header { border-bottom: var(--rule); }
  .header-row { display: flex; align-items: center; justify-content: space-between; gap: var(--s2); padding-block: var(--s2); flex-wrap: wrap; }
  nav { display: flex; gap: var(--s3); flex-wrap: wrap; }
  nav a { font-family: var(--font-mono); font-size: var(--step--1); text-transform: uppercase; letter-spacing: var(--track-label); min-height: var(--control-h); display: inline-flex; align-items: center; }
  .site-footer { border-top: var(--perforation); margin-top: var(--s8); }
  .footer-row { display: grid; gap: var(--s3); padding-block: var(--s4); grid-template-columns: 2fr 1fr; }
  .disclaimer { font-size: 0.9375rem; color: var(--ink-faded); margin: 0; }
  .site-footer nav { flex-direction: column; gap: 0; }
  @media (max-width: 48rem) { .footer-row { grid-template-columns: 1fr; } }
</style>
