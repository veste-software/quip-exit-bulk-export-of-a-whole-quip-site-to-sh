# Names only. Never put values in this file or commit a .env.

# --- Static site (build time, public) ---
# URL of the deployed Cloudflare Worker relay, e.g. https://relay.<domain>
PUBLIC_RELAY_URL=
# Cloudflare Web Analytics beacon token (cookie-free). Leave empty to ship no analytics at all.
PUBLIC_CF_ANALYTICS_TOKEN=
# Set by the GitHub Pages workflow for previews; empty for a root deploy.
SITE_URL=
SITE_BASE=

# --- Worker relay (wrangler secrets / vars, never in the static build) ---
# Comma-separated Quip API hosts the relay may reach, e.g. platform.quip.com
QUIP_HOST_ALLOWLIST=
# Stripe, TEST MODE keys only until the owner goes live
STRIPE_SECRET_KEY=
STRIPE_PRICE_SITE=
STRIPE_PRICE_LARGE=
# HMAC secret used to sign licence tokens
LICENSE_SIGNING_SECRET=
